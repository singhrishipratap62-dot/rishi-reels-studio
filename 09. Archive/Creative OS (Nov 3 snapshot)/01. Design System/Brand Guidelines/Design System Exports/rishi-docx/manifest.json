  "libraries": [],
  "components": [
    {
      "name": "BarChart",
      "group": "Data",
      "summary": "A simple bar chart that grows on the grid, with one bar highlighted in signal."
    },
    {
      "name": "ChatFrame",
      "group": "Context",
      "summary": "A recreated chat with an AI, shown as UI, with the key phrase highlighted."
    },
    {
      "name": "FlowDiagram",
      "group": "Diagrams",
      "summary": "Numbered steps in square boxes connected by drawn lines, showing how something works."
    },
    {
      "name": "HookTitle",
      "group": "Titles",
      "summary": "The opening headline of a reel, carousel or cover: big General Sans with one Gambetta italic phrase in signal."
    },
    {
      "name": "LowerThird",
      "group": "Context",
      "summary": "The name and role of a person or organisation on screen."
    },
    {
      "name": "PenMarks",
      "group": "Pen",
      "summary": "Hand-drawn marks in signal red that point at what matters: underline, circle, arrow, strike-through and tick."
    },
    {
      "name": "QuoteCard",
      "group": "Context",
      "summary": "A direct quote from a person, company, court or report, set in Gambetta."
    },
    {
      "name": "SourceCard",
      "group": "Context",
      "summary": "A small card naming where a fact comes from."
    },
    {
      "name": "SplitCompare",
      "group": "Diagrams",
      "summary": "Two columns side by side — what people think vs what's true, before vs after — with a strike and a tick."
    },
    {
      "name": "StatReveal",
      "group": "Data",
      "summary": "A single important number that counts up, with its unit, one line of context and its source."
    },
    {
      "name": "Timeline",
      "group": "Diagrams",
      "summary": "A spine that draws across the frame with dated stops landing in order."
    }
  ],
