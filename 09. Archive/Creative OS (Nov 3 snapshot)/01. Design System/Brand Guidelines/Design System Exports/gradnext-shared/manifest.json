  "components": [
    {
      "name": "Wordmark",
      "group": "Brand",
      "summary": "The gradnext logo — a lowercase text-only wordmark — rendered from the guideline artwork as inline SVG."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "A text button for digital surfaces — an intentional addition, since the guidelines define colour pairings but no button."
    },
    {
      "name": "ValueCard",
      "group": "Brand",
      "summary": "A rounded dark-glass card with a periwinkle under-glow that presents one brand value or pillar."
    },
    {
      "name": "OverlayTile",
      "group": "Color",
      "summary": "One approved colour-overlay pairing: a rounded square fill centred on a rounded square ground."
    },
    {
      "name": "PartnerLockup",
      "group": "Brand",
      "summary": "gradnext set beside a partner brand with equal respect — neither logo dominates."
    }
  ],
